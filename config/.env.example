# ─────────────────────────────────────────────
# PhantomDroid — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to GitHub!
# ─────────────────────────────────────────────

# ── Claude AI (Anthropic) ──
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Firebase ──
# Get from: Firebase Console → Project Settings → Your Apps
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ── VirusTotal ──
# Get from: https://www.virustotal.com/gui/my-apikey (free account)
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# ── MySQL (Railway auto-fills these on deploy) ──
# Local development: fill manually
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=phantomdroid

# ── Flask ──
FLASK_ENV=development
SECRET_KEY=change_this_to_a_random_string_in_production
PORT=5000
