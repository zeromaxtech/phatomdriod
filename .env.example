# PhantomDroid — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── AI Providers (add at least ONE) ──────────────────────────────────────────
# App automatically cascades: Groq → Cerebras → OpenRouter → Gemini

# Groq (free, fastest) → https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Cerebras (free) → https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenRouter (free Qwen model) → https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini (free tier) → https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (optional, paid) → https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Firebase (optional — for real-time dashboard) ─────────────────────────────
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ── VirusTotal (optional) → https://virustotal.com ───────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# ── Android ADB Path ─────────────────────────────────────────────────────────
# Leave ANDROID_HOME if using standard Android Studio SDK
# Or set ADB_PATH to the exact adb.exe location
ANDROID_HOME=C:\Users\YourName\AppData\Local\Android\Sdk
# ADB_PATH=C:\Program Files\ASUS\GlideX\adb.exe   ← uncomment if needed

# ── MySQL (optional — app uses SQLite locally without this) ──────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=phantomdroid

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change_this_in_production
PORT=5000
BACKEND_URL=http://localhost:5000
